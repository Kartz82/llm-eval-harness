# Copy to .env. NEVER commit .env.

# Target under test: mock (offline) | http (a running agent API) | gemini (direct)
EVAL_TARGET=mock

# For target=http (e.g. the Support Agent at http://localhost:8000)
AGENT_BASE_URL=http://localhost:8000

# For target=gemini or the optional LLM-judge
GOOGLE_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Release gate: minimum pass rate [0..1] required for exit code 0
PASS_THRESHOLD=1.0

# Optional Langfuse observability (off unless keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
